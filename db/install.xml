<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/lsf_unification/db" VERSION="20130611" COMMENT="XMLDB file for Moodle local/lsf_unification"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:noNamespaceSchemaLocation="../../../lib/xmldb/xmldb.xsd"
>
  <TABLES>
    <TABLE NAME="local_lsf_unification_category" COMMENT="table containing his categories and info about their learnweb equivalent" NEXT="local_lsf_unification_categoryparenthood">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="moodle dumbness" NEXT="ueid"/>
        <FIELD NAME="ueid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="id from his" PREVIOUS="id" NEXT="parent"/>
        <FIELD NAME="parent" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="parent category ueid from his" PREVIOUS="ueid" NEXT="origin"/>
        <FIELD NAME="origin" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="origin id from his (oldest transitively chained quellid)" PREVIOUS="parent" NEXT="mdlid"/>
        <FIELD NAME="mdlid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="id of equivalent moodle category" PREVIOUS="origin" NEXT="txt"/>
        <FIELD NAME="txt" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="category's title from his" PREVIOUS="mdlid" NEXT="txt2"/>
        <FIELD NAME="txt2" TYPE="text" NOTNULL="false" SEQUENCE="false" COMMENT="fullname (path of txts)" PREVIOUS="txt" NEXT="timestamp"/>
        <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="zeitstempel" PREVIOUS="txt2"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" NEXT="realkey"/>
        <KEY NAME="realkey" TYPE="unique" FIELDS="ueid" PREVIOUS="primary"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_lsf_unification_categoryparenthood" COMMENT="relations between his-categories" PREVIOUS="local_lsf_unification_category" NEXT="local_lsf_unification_course_matching">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" COMMENT="moodle dumbness" NEXT="child"/>
        <FIELD NAME="child" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" PREVIOUS="id" NEXT="parent"/>
        <FIELD NAME="parent" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" PREVIOUS="child" NEXT="distance"/>
        <FIELD NAME="distance" TYPE="int" LENGTH="5" NOTNULL="true" SEQUENCE="false" COMMENT="Distance in the parent chain: direct parent = 1, grandparent = 2, etc." PREVIOUS="parent"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" NEXT="realkey"/>
        <KEY NAME="realkey" TYPE="unique" FIELDS="child, parent" PREVIOUS="primary"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_lsf_unification_course_matching" COMMENT="course matching table (old structure, will be deprecated)" PREVIOUS="local_lsf_unification_categoryparenthood">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true" NEXT="veranstid"/>
        <FIELD NAME="veranstid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" PREVIOUS="id" NEXT="mdlid"/>
        <FIELD NAME="mdlid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="coresponding moodle id" PREVIOUS="veranstid" NEXT="timestamp"/>
        <FIELD NAME="timestamp" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" COMMENT="last import of course" PREVIOUS="mdlid" NEXT="requeststate"/>
        <FIELD NAME="requeststate" TYPE="int" LENGTH="5" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="0=declined or not requested,1=requested,2=granted" PREVIOUS="timestamp" NEXT="requesterid"/>
        <FIELD NAME="requesterid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" PREVIOUS="requeststate" NEXT="acceptorid"/>
        <FIELD NAME="acceptorid" TYPE="int" LENGTH="10" NOTNULL="false" SEQUENCE="false" PREVIOUS="requesterid"/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id" NEXT="uni1"/>
        <KEY NAME="uni1" TYPE="unique" FIELDS="veranstid" PREVIOUS="primary"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_lsf_unification_courses" COMMENT="Abstracted courses originating from a campus management system (cms).">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="cms" TYPE="char" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Which cms the course originates from (e.g. lsf, sap)."/>
        <FIELD NAME="instance" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Id of the course in the cms."/>
        <FIELD NAME="title" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Title of the course."/>
        <FIELD NAME="shorttitle" TYPE="char" LENGTH="255" NOTNULL="true" SEQUENCE="false" COMMENT="Short title of the course."/>
        <FIELD NAME="description" TYPE="text" NOTNULL="true" SEQUENCE="false" COMMENT="Description of the course. Empty string when there is none."/>
        <FIELD NAME="teacher" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Username of the main responsible teacher."/>
        <FIELD NAME="semester" TYPE="char" LENGTH="100" NOTNULL="true" SEQUENCE="false" COMMENT="Semester the course belongs to."/>
        <FIELD NAME="created" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Timestamp of when the course was created in the cms."/>
        <FIELD NAME="url" TYPE="char" LENGTH="1333" NOTNULL="true" SEQUENCE="false" COMMENT="Url to the course in the cms."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
      </KEYS>
      <INDEXES>
        <INDEX NAME="cms_instance" UNIQUE="true" FIELDS="cms, instance" COMMENT="A cms course is uniquely identified by its cms and instance id."/>
      </INDEXES>
    </TABLE>
    <TABLE NAME="local_lsf_unification_course_requests" COMMENT="Pending import requests opened when a non-teacher tries to import a cms course.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="requesterid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle user id of the user that requested the course."/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Abstract course id (local_lsf_unification_courses.id, not a moodle course id)."/>
        <FIELD NAME="state" TYPE="int" LENGTH="2" NOTNULL="true" DEFAULT="0" SEQUENCE="false" COMMENT="Current state of the request: 1=pending, 2=accepted, 3=declined, 4=imported."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign" FIELDS="courseid" REFTABLE="local_lsf_unification_courses" REFFIELDS="id"/>
        <KEY NAME="requesterid" TYPE="foreign" FIELDS="requesterid" REFTABLE="user" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
    <TABLE NAME="local_lsf_unification_imported_courses" COMMENT="Links an abstracted cms course to the moodle course it was imported into.">
      <FIELDS>
        <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
        <FIELD NAME="moodleid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Moodle course id (course.id)."/>
        <FIELD NAME="courseid" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="false" COMMENT="Abstract course id (local_lsf_unification_courses.id)."/>
      </FIELDS>
      <KEYS>
        <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
        <KEY NAME="courseid" TYPE="foreign-unique" FIELDS="courseid" REFTABLE="local_lsf_unification_courses" REFFIELDS="id"/>
        <KEY NAME="moodleid" TYPE="foreign" FIELDS="moodleid" REFTABLE="course" REFFIELDS="id"/>
      </KEYS>
    </TABLE>
  </TABLES>
</XMLDB>